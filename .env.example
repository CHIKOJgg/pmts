# PMTS Environment Configuration
# Copy to .env and fill in values before running

# ── Exchange credentials ───────────────────────────────────────────────────────
PM_CLOB_URL=https://clob.polymarket.com
PM_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
PM_API_KEY=
PM_API_SECRET=
PM_PASSPHRASE=
PM_WALLET_KEY=
PM_TAKER_FEE_BPS=20

OP_REST_URL=https://api.opinion.markets/v1
OP_WS_URL=wss://ws.opinion.markets
OP_API_KEY=
OP_WALLET_KEY=
OP_CTF_EXCHANGE_ADDR=
OP_TAKER_FEE_BPS=25

# ── Markets to trade ───────────────────────────────────────────────────────────
# Comma-separated list of market IDs
MARKETS=
# ── Capital and risk ──────────────────────────────────────────────────────────
INITIAL_CASH_USDC=100
KILL_SWITCH_TOKEN=CHANGE-ME-USE-A-SECURE-RANDOM-STRING

DRAWDOWN_KILL_PCT=0.20
DRAWDOWN_WARN_PCT=0.15
MAX_ORDER_USDC=200
MIN_ORDER_USDC=1.0
MAX_MARKET_EXP_PCT=0.05
MAX_MARKET_EXP_USDC=500
MAX_NET_DELTA=50

ARB_BUDGET_USDC=2000
MM_BUDGET_USDC=3000

# ── Strategy toggles ──────────────────────────────────────────────────────────
ENABLE_TRADING=false
ENABLE_ARB=true
ENABLE_MM=true
ENABLE_HEDGE=true

# ── AI module ─────────────────────────────────────────────────────────────────
AI_ENABLED=false
AI_USE_HEURISTIC_ONLY=false
AI_PROVIDER=anthropic                     # "anthropic" (Claude API) or "openrouter"
ANTHROPIC_API_KEY=                        # required if AI_PROVIDER=anthropic
OPENROUTER_API_KEY=                       # required if AI_PROVIDER=openrouter
OPENROUTER_MODEL=anthropic/claude-sonnet-4    # any OpenRouter model slug
AI_API_TIMEOUT_MS=200
AI_CACHE_TTL_MS=3000

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
POSTGRES_URL=postgresql://pmts:pmts@localhost:5432/pmts
POSTGRES_ENABLED=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# ── Alerting ──────────────────────────────────────────────────────────────────
ALERT_SLACK_WEBHOOK=
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_RECIPIENTS=
ALERT_WEBHOOK_URLS=
